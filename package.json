{
  "name": "llmxray",
  "version": "0.8.11",
  "mcpName": "io.github.LogneBudo/llmxray",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LogneBudo/llmxray.git"
  },
  "homepage": "https://lognebudo.github.io/llmxray/",
  "bugs": {
    "url": "https://github.com/LogneBudo/llmxray/issues"
  },
  "description": "Local LLM Observatory — See what your AI is actually doing, token by token.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "llmxray": "bin/cli.mjs",
    "llmxray-mcp": "bin/mcp.mjs"
  },
  "files": [
    "dist/",
    "server/",
    "!server/*.test.mjs",
    "bin/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:e2e:live": "playwright test --project=live-ollama",
    "test:e2e:live:headed": "playwright test --project=live-ollama --headed",
    "test:e2e:all": "playwright test",
    "screenshots": "node scripts/readme-media.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "bash scripts/deploy-site.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@lucide/vue": "^1.59.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/d3": "^7.4.3",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue/test-utils": "^2.4.6",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "dexie": "^4.3.0",
    "diff": "^9.0.0",
    "flag-icons": "^7.5.0",
    "franc-min": "^6.2.0",
    "happy-dom": "^21.0.3",
    "mammoth": "^1.11.0",
    "marked": "^18.1.1",
    "nanoid": "^6.0.2",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.1.0",
    "recast": "^0.24.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-codemirror": "^6.1.1",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.0.3",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.4"
    },
    "mammoth": {
      "argparse": "^2.0.1"
    },
    "@intlify/unplugin-vue-i18n": {
      "@intlify/vue-i18n-extensions": "^9.0.0"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  },
  "engines": {
    "node": ">=22"
  }
}
