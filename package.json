{
  "name": "llmxray",
  "version": "0.4.5",
  "description": "Local LLM Observatory — See what your AI is actually doing, token by token.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "llmxray": "./bin/cli.mjs"
  },
  "files": [
    "dist/",
    "server/",
    "bin/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:e2e:live": "playwright test --project=live-ollama",
    "test:e2e:live:headed": "playwright test --project=live-ollama --headed",
    "test:e2e:all": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "bash scripts/deploy-site.sh"
  },
  "dependencies": {
    "dexie": "^4.3.0",
    "express": "^5.1.0",
    "flag-icons": "^7.5.0",
    "franc-min": "^6.2.0",
    "http-proxy-middleware": "^3.0.3",
    "lucide-vue-next": "^0.577.0",
    "vue-i18n": "^10.0.8"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/d3": "^7.4.3",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue/test-utils": "^2.4.6",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "diff": "^8.0.3",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.8.3",
    "mammoth": "^1.11.0",
    "marked": "^17.0.4",
    "nanoid": "^5.1.6",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.5.207",
    "pinia": "^3.0.4",
    "recast": "^0.23.11",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^5.0.3",
    "vue-tsc": "^3.2.5"
  }
}
